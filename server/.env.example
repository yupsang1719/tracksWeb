# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT
JWT_SECRET=<generate-with: node -e "require('crypto').randomBytes(64).toString('hex')" >

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Gmail app password — NOT your Google account password)
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# App
NODE_ENV=production
CLIENT_URL=https://tracksaldershot.co.uk
PORT=8000

# Admin seed (only needed when running: node seedAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!!
